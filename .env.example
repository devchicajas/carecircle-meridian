# Meridian (LightLeap) — server-side only. Never expose to the browser.
# Never prefix secrets with NEXT_PUBLIC_.
MERIDIAN_API_KEY=mk_live_your_key_here
MERIDIAN_BASE_URL=https://dev.lightleap.ai/meridian
MERIDIAN_TENANT=build-90f628cf19f2414abab1bb2cea64614189

# Optional: signing secret for CareCircle account cookies (falls back to API key in dev).
# AUTH_SECRET=generate-a-long-random-string

# Optional managed IdP (not wired until secrets are bound):
# AUTH0_SECRET=
# AUTH0_BASE_URL=
# AUTH0_ISSUER_BASE_URL=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# OpenAPI:
# https://dev.lightleap.ai/meridian/api/ext/v1/openapi?tenant=build-90f628cf19f2414abab1bb2cea64614189
#
# Exposed objects:
# patient, caregiver, careCircleMembership, carePlan, appointment, medication, careTask, notification
# Mutations use body shape: { "values": { ...fields }, "reason": "optional" }

# Secure Admin provisioning (never used by public signup)
# CARECIRCLE_ADMIN_BOOTSTRAP_TOKEN=generate-a-long-random-string
# Then: node scripts/provision-admin.mjs --email admin@example.com --password '...'
